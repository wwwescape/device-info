<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup for API 23-30 (API 31+ uses data_extraction_rules.xml). An explicit allowlist:
     only the user's own preferences are worth restoring. Device-specific caches (e.g. the
     resolved marketing name) and per-widget-ID Glance state are meaningless on another device. -->
<full-backup-content>
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="sharedpref" path="theme_prefs_sync.xml" />
</full-backup-content>
