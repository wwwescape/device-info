<?xml version="1.0" encoding="utf-8"?>
<!-- Backup/transfer for API 31+. Same allowlist as backup_rules.xml: only user preferences. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="theme_prefs_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="theme_prefs_sync.xml" />
    </device-transfer>
</data-extraction-rules>
